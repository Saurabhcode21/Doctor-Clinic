# ========================================================
# 🏥 Sanjeevani Clinic - Server Environment Configuration
# ========================================================

# Server Port (PaaS hosts like Render/Railway set this automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret Key (CRITICAL: Change this to a long random secret in production)
JWT_SECRET=sanjeevani_super_secret_jwt_key_2026_prod

# Allowed CORS Origin (e.g. https://clinic.yourdomain.com or * for open access)
CORS_ORIGIN=*

# Clinic QR Code Public URL (Used for generating reception counter QR standees)
CLINIC_BASE_URL=http://localhost:5000
